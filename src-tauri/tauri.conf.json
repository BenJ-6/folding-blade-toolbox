{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "折刀雀工具箱",
  "version": "0.1.1",
  "identifier": "com.ben.folding-blade-toolbox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "折刀雀工具箱",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Ben J.",
    "licenseFile": "../LICENSE",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMTRDRjg1NTNBRjhERkUKUldUK2phOVRoYzhVN0g2R1hLOG8yTGZZRkRyVHhvZUxuY2UrdXlwYTl0WEJyN2tVaU9PdFFCaVUK",
      "endpoints": [
        "https://github.com/BenJ-6/folding-blade-toolbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
